{
  "cars": {
    "CVEV.USA.": "ev6",
    "CVEV.CAN.": "ev6_ca",
    "NEEV.USA.": "neev",
    "NEEV.CAN.": "neev_ca",
    "NEEV.KOR.": "neev_kr",
    "NEEV23.USA.": "neev"
  },
  "stock": "patches/{set}/stock",
  "expect": "patches/{set}/expect",
  "changes": [
    {
      "type": "lines",
      "path": "/system/onebin/{onebin}/featurexml.cfg",
      "stock": "any",
      "part": "projection",
      "comment": [
        "-/system/etc/permissions/com.hkmc.software.wifihotspot.xml"
      ]
    },
    {
      "type": "prop",
      "key": "persist.ium.support",
      "value": "carplay",
      "part": "projection"
    },
    {
      "type": "add",
      "path": "/system/etc/permissions/com.hkmc.software.wifihotspot.xml",
      "src": "files/com.hkmc.software.wifihotspot.xml",
      "stock": "absent",
      "optional": true,
      "mode": "644",
      "part": "kor-hotspot"
    },
    {
      "type": "prop",
      "key": "persist.sys.iap2.wifi",
      "value": "t",
      "part": "bridge"
    },
    {
      "type": "prop",
      "key": "persist.iap2.iden.wireless",
      "value": "t",
      "part": "bridge"
    },
    {
      "type": "add",
      "path": "/system/lib/libleafiaaac.so",
      "src": "files/libleafiaaac.so",
      "mode": "644",
      "part": "audio"
    }
  ]
}
